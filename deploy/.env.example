# Copy to .env and fill all placeholders; never commit the populated file.
# Use URL-safe database/Redis passwords because URLs interpolate these values.
META_DB_PASSWORD=replace-with-url-safe-random-password
IMPORT_ADMIN_PASSWORD=replace-with-url-safe-random-password
IMPORT_WRITER_PASSWORD=replace-with-url-safe-random-password
IMPORT_READER_PASSWORD=replace-with-url-safe-random-password
REDIS_PASSWORD=replace-with-url-safe-random-password
MINIO_ACCESS_KEY=replace-with-random-access-key
MINIO_SECRET_KEY=replace-with-random-secret-key
JWT_SECRET=replace-with-at-least-32-random-characters
# Generate with cryptography.fernet.Fernet.generate_key(); this is NOT a usable key.
ENCRYPTION_KEY=replace-with-fernet-key
