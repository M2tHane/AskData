ASKDATA_ENVIRONMENT=development
# Set secrets before enabling production; never commit a populated .env.
ASKDATA_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/askdata
ASKDATA_REDIS_URL=redis://localhost:6379/0
ASKDATA_JWT_SECRET=
# A URL-safe base64 Fernet key (32 random bytes).
ASKDATA_ENCRYPTION_KEY=
ASKDATA_MINIO_ENDPOINT=localhost:9000
ASKDATA_MINIO_ACCESS_KEY=
ASKDATA_MINIO_SECRET_KEY=
ASKDATA_MINIO_BUCKET=askdata
ASKDATA_MINIO_SECURE=true
